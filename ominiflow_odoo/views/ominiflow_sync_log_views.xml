<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ominiflow_sync_log_list" model="ir.ui.view">
        <field name="name">ominiflow.sync.log.list</field>
        <field name="model">ominiflow.sync.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="started_at"/>
                <field name="instance_id"/>
                <field name="resource_type"/>
                <field name="operation"/>
                <field name="direction"/>
                <field name="external_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"
                       decoration-info="status == 'running'"
                       decoration-muted="status == 'pending'"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_ominiflow_sync_log_form" model="ir.ui.view">
        <field name="name">ominiflow.sync.log.form</field>
        <field name="model">ominiflow.sync.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="resource_type"/>
                            <field name="operation"/>
                            <field name="direction"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="external_id"/>
                            <field name="odoo_model"/>
                            <field name="odoo_record_id"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ominiflow_sync_log_search" model="ir.ui.view">
        <field name="name">ominiflow.sync.log.search</field>
        <field name="model">ominiflow.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="instance_id"/>
                <field name="external_id"/>
                <field name="message"/>
                <filter name="filter_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="filter_successful" string="Successful" domain="[('status', '=', 'success')]"/>
                <separator/>
                <filter name="filter_product" string="Products" domain="[('resource_type', '=', 'product')]"/>
                <filter name="filter_customer" string="Customers" domain="[('resource_type', '=', 'customer')]"/>
                <filter name="filter_webhook" string="Webhooks" domain="[('resource_type', '=', 'webhook')]"/>
                <separator/>
                <filter name="filter_today" string="Today" domain="[('started_at', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_instance" string="Connection" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_resource" string="Resource" context="{'group_by': 'resource_type'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'started_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ominiflow_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">ominiflow.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ominiflow_sync_log_search"/>
        <field name="context">{'search_default_filter_failed': 0}</field>
    </record>
</odoo>
