<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_ominiflow" model="ir.ui.view">
        <field name="name">res.partner.form.ominiflow</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="OminiFlow" name="ominiflow" groups="ominiflow_odoo.group_ominiflow_user">
                    <group>
                        <field name="ominiflow_instance_id"/>
                        <field name="ominiflow_id"/>
                        <field name="ominiflow_last_sync"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_ominiflow_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ominiflow_id', '!=', False)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No OminiFlow customers yet</p>
            <p>Run Sync Customers on a connection to import WhatsApp contacts.</p>
        </field>
    </record>
</odoo>
