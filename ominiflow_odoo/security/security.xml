<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_ominiflow">
        <field name="name">OminiFlow</field>
        <field name="sequence">48</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_ominiflow_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ominiflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read connections and logs. Cannot see API keys.</field>
    </record>

    <record id="group_ominiflow_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ominiflow"/>
        <field name="implied_ids" eval="[(4, ref('group_ominiflow_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configure connections, API keys, and run synchronization.</field>
    </record>

    <record id="rule_ominiflow_instance_company" model="ir.rule">
        <field name="name">OminiFlow instance: multi-company</field>
        <field name="model_id" ref="model_ominiflow_instance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ominiflow_user'))]"/>
    </record>

    <record id="rule_ominiflow_log_company" model="ir.rule">
        <field name="name">OminiFlow sync log: multi-company</field>
        <field name="model_id" ref="model_ominiflow_sync_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ominiflow_user'))]"/>
    </record>

    <record id="rule_ominiflow_binding_company" model="ir.rule">
        <field name="name">OminiFlow binding: multi-company</field>
        <field name="model_id" ref="model_ominiflow_binding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ominiflow_user'))]"/>
    </record>
</odoo>
