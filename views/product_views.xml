<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_ominiflow_form" model="ir.ui.view">
        <field name="name">product.template.form.ominiflow</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="OminiFlow" name="ominiflow" groups="ominiflow_odoo.group_ominiflow_user">
                    <group>
                        <field name="ominiflow_instance_id"/>
                        <field name="ominiflow_id"/>
                        <field name="ominiflow_last_sync"/>
                        <field name="ominiflow_stock_quantity"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_ominiflow_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ominiflow_id', '!=', False)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No OminiFlow products yet</p>
            <p>Run Sync Products on a connection to import the WhatsApp catalog.</p>
        </field>
    </record>
</odoo>
